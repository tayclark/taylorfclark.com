---
import Layout from '../layouts/Layout.astro';
import { clientSites, projects } from '../data/projects';
---

<Layout
	title="Projects — Taylor Clark"
	description="osprey, coast-crm and gulf-coast-fishing-app: integration, SaaS and offline-first mobile work."
>
	<main id="main" class="page-main">
		<h1 class="page-title">Projects</h1>

		{projects.map((project) => (
			<article class="card">
				<h2>
					{project.link ? <a href={project.link}>{project.name}</a> : project.name}
					<span class="tag">{project.tag}</span>
				</h2>
				<p>{project.description}</p>
				<dl class="study">
					<dt>Problem</dt>
					<dd>{project.problem}</dd>
					<dt>Approach</dt>
					<dd>{project.approach}</dd>
					<dt>Outcome</dt>
					<dd>{project.outcome}</dd>
					{project.metric && (
						<>
							<dt>Metric</dt>
							<dd>{project.metric}</dd>
						</>
					)}
				</dl>
				<ul class="stack" aria-label={`${project.name} stack`}>
					{project.stack.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				{!project.link && <p class="private">Private repository.</p>}
			</article>
		))}

		<section class="card">
			<h2>Client sites</h2>
			<p>
				Shipped and billed for real clients:{' '}
				{clientSites.map((site) => `${site.name} (${site.note.toLowerCase()})`).join(', ')}.
			</p>
		</section>
	</main>
</Layout>

<style>
	.card h2 {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.card .tag {
		font-size: var(--text-xs);
		font-weight: 400;
		color: var(--color-text-dim);
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}

	.card p {
		margin: 0;
	}

	.study {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: var(--space-2) var(--space-4);
		margin: var(--space-4) 0 0;
	}

	.study dt {
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--color-text-dim);
	}

	.study dd {
		margin: 0;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		margin: var(--space-4) 0 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-dim);
	}

	.stack li::before {
		content: '#';
		opacity: 0.6;
	}

	.private {
		margin-top: var(--space-3);
		font-size: var(--text-xs);
		color: var(--color-text-dim);
	}

	@media (max-width: 40rem) {
		.study {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.study dd {
			margin-bottom: var(--space-3);
		}
	}
</style>
