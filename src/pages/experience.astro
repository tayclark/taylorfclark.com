---
import Layout from '../layouts/Layout.astro';
import { resume } from '../data/resume';

const experience = resume.sections.find((section) => section.title === 'Experience')?.entries ?? [];
---

<Layout
	title="Experience — Taylor Clark"
	description="A decade of backend and integrations experience: Coast Software, Vitally, Tray.io, Cloud Elements."
>
	<main id="main" class="page-main">
		<h1 class="page-title">Experience</h1>

		{experience.map((job) => (
			<article class="card">
				<h2>
					{job.role}, {job.org}
				</h2>
				<p class="dates">{job.dates}</p>
				{job.blurb && <p>{job.blurb}</p>}
				<ul>
					{job.bullets.map((bullet) => (
						<li>{bullet}</li>
					))}
				</ul>
				{job.tech && <p class="tech">Technologies: {job.tech}</p>}
			</article>
		))}
	</main>
</Layout>

<style>
	.card .dates {
		font-size: var(--text-sm);
		color: var(--color-text-dim);
		margin: 0 0 0.5rem;
	}

	.card p {
		margin: 0 0 0.5rem;
	}

	.card .tech {
		font-size: var(--text-sm);
		color: var(--color-text-dim);
		margin: 0.75rem 0 0;
	}

	.card ul {
		margin: 0.5rem 0 0;
		padding-left: 1.2rem;
	}

	.card li {
		margin-bottom: 0.35rem;
	}
</style>
