---
import Layout from '../layouts/Layout.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import { resume } from '../data/resume';
import { SITE_DESCRIPTION, SITE_TITLE, contactLinks, terminalTargets } from '../data/site';
const emailLink = contactLinks.find((link) => link.key === 'email');
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main id="main">
		<header class="hero">
			<h1>Taylor Clark</h1>
			<p class="tagline">Backend &amp; integrations engineer · Ocean Springs, MS</p>
			<p class="positioning">
				Currently running technical delivery for a small multi-product shop.
			</p>
			<p class="outside">Fishing, birding, photography/hiking, and vibe coding.</p>

			<p class="cta">
				<a class="cta-primary" href="/projects">
					View projects
				</a>
				<a class="cta-secondary" href={emailLink?.href}>
					Email me
				</a>
			</p>

			<nav class="contact-links" aria-label="Contact links">
				{contactLinks.map((link) => (
					<a
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
					>
						{link.key === 'github' && (
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
							</svg>
						)}
						{link.key === 'linkedin' && (
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
								<rect x="2" y="9" width="4" height="12" />
								<circle cx="4" cy="4" r="2" />
							</svg>
						)}
						{link.key === 'email' && (
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
								<polyline points="22 6 12 13 2 6" />
							</svg>
						)}
						<span>{link.label}</span>
						{link.external && <span class="sr-only">(opens in new tab)</span>}
					</a>
				))}
			</nav>

			<div class="terminal-card">
				<p class="terminal-label">or, try the terminal —</p>
				<TerminalPrompt targets={terminalTargets} resume={resume} />
			</div>
		</header>
	</main>
</Layout>

<style>
	/* Top-aligned, not vertically centred: centring re-centres the whole hero whenever
	   the viewport resizes or the terminal output grows, which reads as a layout shift. */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-5);
		text-align: center;
		padding: var(--space-16) var(--space-6) var(--space-12);
	}

	h1 {
		font-size: var(--text-2xl);
		margin: 0;
	}

	.tagline {
		margin: 0;
		color: var(--color-text-dim);
	}

	.positioning {
		margin: -0.75rem 0 0;
		color: var(--color-text-dim);
	}

	.outside {
		margin: -0.75rem 0 0;
		font-size: var(--text-md);
		color: var(--color-text-dim);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3) var(--space-4);
		margin: 0;
	}

	.cta a {
		padding: 0.5rem 1.1rem;
		border: 1px solid var(--color-accent);
		border-radius: var(--radius-lg);
		text-decoration: none;
	}

	.cta-primary {
		background: var(--color-accent);
		color: var(--color-bg);
	}

	.cta-secondary {
		color: var(--color-accent);
	}

	.cta a:hover {
		opacity: 0.85;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3) var(--space-6);
		font-size: var(--text-base);
	}

	.contact-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.15rem;
	}

	.contact-links svg {
		flex-shrink: 0;
	}

	.contact-links a:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.terminal-card {
		--color-bg: var(--term-bg);
		--color-text: var(--term-text);
		--color-text-dim: var(--term-dim);
		--color-accent: var(--term-accent);

		width: 100%;
		max-width: 28rem;
		margin-top: var(--space-6);
		background: var(--color-bg);
		border: 1px solid var(--term-border);
		border-radius: var(--radius-lg);
		padding: var(--space-5) var(--space-6);
		box-shadow: 0 1rem 2.5rem var(--term-shadow);
		text-align: left;
	}

	.terminal-label {
		margin: 0 0 0.6rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-dim);
	}
</style>
