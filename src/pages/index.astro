---
import Layout from '../layouts/Layout.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';

const links = [
	{ label: 'open github', href: 'https://github.com/tayclark', key: 'github', verb: 'open' as const, external: true },
	{
		label: 'open linkedin',
		href: 'https://www.linkedin.com/in/taylorfc',
		key: 'linkedin',
		verb: 'open' as const,
		external: true,
	},
	{
		label: 'open email',
		href: 'mailto:taylorfclark@gmail.com',
		key: 'email',
		verb: 'open' as const,
		external: false,
	},
	{ label: 'cd projects', href: '/projects', key: 'projects', verb: 'cd' as const, external: false },
	{ label: 'cd experience', href: '/experience', key: 'experience', verb: 'cd' as const, external: false },
];
---

<Layout
	title="Taylor Clark — Software & Integration Engineer"
	description="Backend and integrations engineer with a decade of experience building and operating production systems at early-stage SaaS startups."
>
	<main>
		<h1>Taylor Clark</h1>
		<p class="tagline">Backend &amp; integrations engineer · Ocean Springs, MS</p>
		<p class="outside">Fishing, birding, photography/hiking, and vibe coding.</p>

		<nav class="links">
			{
				links.map((link) => (
					<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
						<span class="prompt" aria-hidden="true">$</span> {link.label}
					</a>
				))
			}
		</nav>

		<TerminalPrompt targets={links.map(({ key, verb, href, external }) => ({ key, verb, href, external }))} />
	</main>
</Layout>

<style>
	main {
		min-height: 100dvh;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.75rem;
		text-align: center;
	}

	h1 {
		font-size: 2rem;
		margin: 0;
	}

	.tagline {
		margin: 0;
		color: var(--color-text-dim);
	}

	.outside {
		margin: -1.25rem 0 0;
		font-size: 0.9rem;
		color: var(--color-text-dim);
	}

	.links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
	}

	.links a {
		text-decoration: none;
		color: var(--color-text);
	}

	.links a:hover {
		color: var(--color-accent);
	}

	.links .prompt {
		color: var(--color-accent);
	}

	main :global(.terminal) {
		width: 100%;
		max-width: 22rem;
		text-align: left;
	}
</style>
