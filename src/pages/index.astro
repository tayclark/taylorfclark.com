---
import Layout from '../layouts/Layout.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import resumeText from '../data/resume.txt?raw';

const contactLinks = [
	{
		label: 'GitHub',
		href: 'https://github.com/tayclark',
		key: 'github',
		verb: 'open' as const,
		external: true,
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/taylorfc',
		key: 'linkedin',
		verb: 'open' as const,
		external: true,
	},
	{
		label: 'Email',
		href: 'mailto:taylorfclark@gmail.com',
		key: 'email',
		verb: 'open' as const,
		external: false,
	},
];

const pageLinks = [
	{ label: 'Projects', href: '/projects', key: 'projects', verb: 'cd' as const, external: false },
	{
		label: 'Experience',
		href: '/experience',
		key: 'experience',
		verb: 'cd' as const,
		external: false,
	},
];

const terminalTargets = [...contactLinks, ...pageLinks].map(({ key, verb, href, external }) => ({
	key,
	verb,
	href,
	external,
}));
---

<Layout
	title="Taylor Clark — Software & Integration Engineer"
	description="Backend and integrations engineer with a decade of experience building and operating production systems at early-stage SaaS startups."
>
	<div class="page">
		<header class="hero">
			<h1>Taylor Clark</h1>
			<p class="tagline">Backend &amp; integrations engineer · Ocean Springs, MS</p>
			<p class="positioning">
				Currently running technical delivery for a small multi-product shop.
			</p>
			<p class="outside">Fishing, birding, photography/hiking, and vibe coding.</p>

			<nav class="contact-links">
				{contactLinks.map((link) => (
					<a
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener' : undefined}
					>
						{link.key === 'github' && (
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
							</svg>
						)}
						{link.key === 'linkedin' && (
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
								<rect x="2" y="9" width="4" height="12" />
								<circle cx="4" cy="4" r="2" />
							</svg>
						)}
						{link.key === 'email' && (
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
								<polyline points="22 6 12 13 2 6" />
							</svg>
						)}
						<span>{link.label}</span>
					</a>
				))}
			</nav>

			<nav class="page-links">
				{pageLinks.map((link) => (
					<a href={link.href}>{link.label}</a>
				))}
			</nav>

			<div class="terminal-card">
				<p class="terminal-label">or, try the terminal —</p>
				<TerminalPrompt targets={terminalTargets} files={{ resume: resumeText.trim() }} />
			</div>
		</header>
	</div>
</Layout>

<style>
	.page {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	.hero {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		text-align: center;
		padding: 1.5rem;
	}

	h1 {
		font-size: 2.25rem;
		margin: 0;
	}

	.tagline {
		margin: 0;
		color: var(--color-text-dim);
	}

	.positioning {
		margin: -0.75rem 0 0;
		color: var(--color-text-dim);
	}

	.outside {
		margin: -0.75rem 0 0;
		font-size: 0.9rem;
		color: var(--color-text-dim);
	}

	.contact-links {
		display: flex;
		gap: 1.5rem;
		font-size: 1.05rem;
	}

	.page-links {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9rem;
	}

	.contact-links a,
	.page-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 0.15rem;
	}

	.contact-links svg {
		flex-shrink: 0;
	}

	.contact-links a:hover,
	.page-links a:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.terminal-card {
		--color-bg: #14150f;
		--color-text: #d9d5c9;
		--color-text-dim: #8a8676;
		--color-accent: #7fbf6b;

		width: 100%;
		max-width: 28rem;
		margin-top: 1.5rem;
		background: var(--color-bg);
		border: 1px solid #2a2c22;
		border-radius: 0.75rem;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 1rem 2.5rem rgba(20, 21, 15, 0.12);
		text-align: left;
	}

	.terminal-label {
		margin: 0 0 0.6rem;
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.75rem;
		color: var(--color-text-dim);
	}
</style>
