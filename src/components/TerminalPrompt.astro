---
import type { ResumeData } from '../data/resume';
import type { Target } from '../lib/terminal';

interface Props {
	targets: Target[];
	resume: ResumeData;
}

const { targets, resume } = Astro.props;
---

<div
	class="terminal"
	id="term-root"
	data-targets={JSON.stringify(targets)}
	data-resume={JSON.stringify(resume)}
>
	<div
		class="output"
		id="term-output"
		role="region"
		aria-label="Terminal output"
		tabindex="0"
	></div>
	<div class="sr-only" id="term-status" role="status"></div>
	<div class="prompt-line">
		<span class="prompt" aria-hidden="true">
			$
		</span>
		<input
			type="text"
			id="term-input"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			aria-label="Terminal command input — try help"
			placeholder="try: help"
		/>
	</div>
</div>

<style>
	.terminal {
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.9rem;
	}

	.output {
		max-height: 5.5em;
		overflow-y: auto;
		margin-bottom: 0.5rem;
		color: var(--color-text-dim);
	}

	/* Everything below targets elements the terminal script creates at runtime,
	   which never receive Astro's compile-time scoping attribute — :global()
	   is required or these rules silently no-op. */

	:global(#term-output div) {
		white-space: pre-wrap;
	}

	:global(.output:has(.block)) {
		max-height: 60vh;
	}

	:global(.resume) {
		white-space: normal;
	}

	:global(.r-name) {
		color: var(--color-accent);
		font-weight: 700;
	}

	:global(.r-contact) {
		color: var(--color-text-dim);
		margin-bottom: 0.5rem;
	}

	:global(.r-summary) {
		margin: 0.5rem 0;
	}

	:global(.r-heading) {
		margin-top: 0.85rem;
		color: var(--color-accent);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.15rem;
	}

	:global(.r-role-line) {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.6rem;
		font-weight: 700;
	}

	:global(.r-dates) {
		color: var(--color-text-dim);
		font-weight: 400;
		white-space: nowrap;
	}

	:global(.r-blurb) {
		margin: 0.2rem 0;
		color: var(--color-text-dim);
		font-style: italic;
	}

	:global(.r-bullets) {
		margin: 0.3rem 0 0.3rem 1.1rem;
		padding: 0;
	}

	:global(.r-bullets li) {
		margin: 0.2rem 0;
	}

	:global(.r-tech) {
		margin: 0.3rem 0 0.5rem;
		color: var(--color-text-dim);
		font-size: 0.85em;
	}

	.prompt-line {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.prompt {
		color: var(--color-accent);
	}

	input {
		flex: 1;
		background: transparent;
		border: none;
		color: var(--color-text);
		font: inherit;
		min-width: 0;
	}

	input:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 4px;
		border-radius: 2px;
	}

	input::placeholder {
		color: var(--color-text-dim);
		opacity: 0.6;
	}
</style>

<script>
	import type { ResumeData } from '../data/resume';
	import { createHistory, openAllMessage, runCommand, type Target } from '../lib/terminal';

	const root = document.getElementById('term-root');
	const output = document.getElementById('term-output');
	const input = document.getElementById('term-input') as HTMLInputElement | null;
	const status = document.getElementById('term-status');
	if (root && output && input && status) {
		const targets: Target[] = JSON.parse(root.dataset.targets ?? '[]');
		const resume: ResumeData | null = JSON.parse(root.dataset.resume ?? 'null');
		const out = output;
		const live = status;
		const history = createHistory();
		const MAX_ANNOUNCEMENTS = 3;

		function trim() {
			while (out.childNodes.length > 6 && out.firstChild) {
				out.removeChild(out.firstChild);
			}
		}

		/** Screen-reader announcement, kept separate from the output so long blocks aren't read aloud. */
		function announce(message: string) {
			const div = document.createElement('div');
			div.textContent = message;
			live.appendChild(div);
			while (live.childNodes.length > MAX_ANNOUNCEMENTS && live.firstChild) {
				live.removeChild(live.firstChild);
			}
		}

		function print(line: string) {
			const div = document.createElement('div');
			div.textContent = line;
			out.appendChild(div);
			announce(line);
			trim();
			out.scrollTop = out.scrollHeight;
		}

		function printResume(data: ResumeData) {
			const container = document.createElement('div');
			container.className = 'block resume';

			const name = document.createElement('div');
			name.className = 'r-name';
			name.textContent = data.name;
			container.appendChild(name);

			const contact = document.createElement('div');
			contact.className = 'r-contact';
			contact.textContent = data.contact;
			container.appendChild(contact);

			const summary = document.createElement('p');
			summary.className = 'r-summary';
			summary.textContent = data.summary;
			container.appendChild(summary);

			for (const section of data.sections) {
				const heading = document.createElement('div');
				heading.className = 'r-heading';
				heading.textContent = section.title;
				container.appendChild(heading);

				for (const entry of section.entries) {
					const roleLine = document.createElement('div');
					roleLine.className = 'r-role-line';
					const roleSpan = document.createElement('span');
					roleSpan.textContent = entry.org ? `${entry.role} — ${entry.org}` : entry.role;
					const datesSpan = document.createElement('span');
					datesSpan.className = 'r-dates';
					datesSpan.textContent = entry.dates;
					roleLine.append(roleSpan, datesSpan);
					container.appendChild(roleLine);

					if (entry.blurb) {
						const blurb = document.createElement('div');
						blurb.className = 'r-blurb';
						blurb.textContent = entry.blurb;
						container.appendChild(blurb);
					}

					if (entry.bullets.length) {
						const ul = document.createElement('ul');
						ul.className = 'r-bullets';
						for (const bullet of entry.bullets) {
							const li = document.createElement('li');
							li.textContent = bullet;
							ul.appendChild(li);
						}
						container.appendChild(ul);
					}

					if (entry.tech) {
						const tech = document.createElement('div');
						tech.className = 'r-tech';
						tech.textContent = `Technologies: ${entry.tech}`;
						container.appendChild(tech);
					}
				}
			}

			out.appendChild(container);
			announce('Resume printed in the terminal output. It is also on the Experience page.');
			trim();
			out.scrollTop = out.scrollHeight;
		}

		function run(raw: string) {
			const { lines, action } = runCommand(raw, { targets, resume });
			for (const line of lines) print(line);
			if (!action) return;

			switch (action.type) {
				case 'print-resume':
					if (resume) printResume(resume);
					break;
				case 'navigate':
					window.location.href = action.href;
					break;
				case 'open':
					window.open(action.href, '_blank', 'noopener');
					break;
				case 'open-all': {
					let blocked = 0;
					for (const t of action.targets) {
						if (!window.open(t.href, '_blank', 'noopener')) blocked += 1;
					}
					print(openAllMessage(action.targets, blocked));
					break;
				}
			}
		}

		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter') {
				const value = input.value;
				run(value);
				history.push(value);
				input.value = '';
			} else if (event.key === 'ArrowUp') {
				const previous = history.up();
				if (previous !== null) {
					input.value = previous;
					requestAnimationFrame(() =>
						input.setSelectionRange(input.value.length, input.value.length),
					);
				}
				event.preventDefault();
			} else if (event.key === 'ArrowDown') {
				input.value = history.down();
				event.preventDefault();
			}
		});
	}
</script>
