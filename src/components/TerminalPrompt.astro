---
import type { ResumeData } from '../data/resume';

interface Target {
	key: string;
	verb: 'open' | 'cd';
	href: string;
	external?: boolean;
}

interface Props {
	targets: Target[];
	resume: ResumeData;
}

const { targets, resume } = Astro.props;
---

<div
	class="terminal"
	id="term-root"
	data-targets={JSON.stringify(targets)}
	data-resume={JSON.stringify(resume)}
>
	<div class="output" id="term-output" aria-live="polite"></div>
	<div class="prompt-line">
		<span class="prompt" aria-hidden="true">
			$
		</span>
		<input
			type="text"
			id="term-input"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			aria-label="Terminal command input — try help"
			placeholder="try: help"
		/>
	</div>
</div>

<style>
	.terminal {
		font-family: ui-monospace, 'SF Mono', Menlo, monospace;
		font-size: 0.9rem;
	}

	.output {
		max-height: 5.5em;
		overflow-y: auto;
		margin-bottom: 0.5rem;
		color: var(--color-text-dim);
	}

	/* Everything below targets elements the terminal script creates at runtime,
	   which never receive Astro's compile-time scoping attribute — :global()
	   is required or these rules silently no-op. */

	:global(#term-output div) {
		white-space: pre-wrap;
	}

	:global(.output:has(.block)) {
		max-height: 60vh;
	}

	:global(.resume) {
		white-space: normal;
	}

	:global(.r-name) {
		color: var(--color-accent);
		font-weight: 700;
	}

	:global(.r-contact) {
		color: var(--color-text-dim);
		margin-bottom: 0.5rem;
	}

	:global(.r-summary) {
		margin: 0.5rem 0;
	}

	:global(.r-heading) {
		margin-top: 0.85rem;
		color: var(--color-accent);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.15rem;
	}

	:global(.r-role-line) {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.6rem;
		font-weight: 700;
	}

	:global(.r-dates) {
		color: var(--color-text-dim);
		font-weight: 400;
		white-space: nowrap;
	}

	:global(.r-blurb) {
		margin: 0.2rem 0;
		color: var(--color-text-dim);
		font-style: italic;
	}

	:global(.r-bullets) {
		margin: 0.3rem 0 0.3rem 1.1rem;
		padding: 0;
	}

	:global(.r-bullets li) {
		margin: 0.2rem 0;
	}

	:global(.r-tech) {
		margin: 0.3rem 0 0.5rem;
		color: var(--color-text-dim);
		font-size: 0.85em;
	}

	.prompt-line {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.prompt {
		color: var(--color-accent);
	}

	input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: var(--color-text);
		font: inherit;
		min-width: 0;
	}

	input::placeholder {
		color: var(--color-text-dim);
		opacity: 0.6;
	}
</style>

<script>
	interface Target {
		key: string;
		verb: 'open' | 'cd';
		href: string;
		external?: boolean;
	}
	interface ResumeEntry {
		role: string;
		org: string;
		dates: string;
		blurb?: string;
		bullets: string[];
		tech: string;
	}
	interface ResumeSection {
		title: string;
		entries: ResumeEntry[];
	}
	interface ResumeData {
		name: string;
		contact: string;
		summary: string;
		sections: ResumeSection[];
	}

	const root = document.getElementById('term-root');
	const output = document.getElementById('term-output');
	const input = document.getElementById('term-input') as HTMLInputElement | null;
	if (root && output && input) {
		const targets: Target[] = JSON.parse(root.dataset.targets ?? '[]');
		const resume: ResumeData | null = JSON.parse(root.dataset.resume ?? 'null');
		const out = output;
		const history: string[] = [];
		let historyIndex = -1;

		function trim() {
			while (out.childNodes.length > 6 && out.firstChild) {
				out.removeChild(out.firstChild);
			}
		}

		function print(line: string) {
			const div = document.createElement('div');
			div.textContent = line;
			out.appendChild(div);
			trim();
			out.scrollTop = out.scrollHeight;
		}

		function printResume(data: ResumeData) {
			const container = document.createElement('div');
			container.className = 'block resume';

			const name = document.createElement('div');
			name.className = 'r-name';
			name.textContent = data.name;
			container.appendChild(name);

			const contact = document.createElement('div');
			contact.className = 'r-contact';
			contact.textContent = data.contact;
			container.appendChild(contact);

			const summary = document.createElement('p');
			summary.className = 'r-summary';
			summary.textContent = data.summary;
			container.appendChild(summary);

			for (const section of data.sections) {
				const heading = document.createElement('div');
				heading.className = 'r-heading';
				heading.textContent = section.title;
				container.appendChild(heading);

				for (const entry of section.entries) {
					const roleLine = document.createElement('div');
					roleLine.className = 'r-role-line';
					const roleSpan = document.createElement('span');
					roleSpan.textContent = entry.org ? `${entry.role} — ${entry.org}` : entry.role;
					const datesSpan = document.createElement('span');
					datesSpan.className = 'r-dates';
					datesSpan.textContent = entry.dates;
					roleLine.append(roleSpan, datesSpan);
					container.appendChild(roleLine);

					if (entry.blurb) {
						const blurb = document.createElement('div');
						blurb.className = 'r-blurb';
						blurb.textContent = entry.blurb;
						container.appendChild(blurb);
					}

					if (entry.bullets.length) {
						const ul = document.createElement('ul');
						ul.className = 'r-bullets';
						for (const bullet of entry.bullets) {
							const li = document.createElement('li');
							li.textContent = bullet;
							ul.appendChild(li);
						}
						container.appendChild(ul);
					}

					if (entry.tech) {
						const tech = document.createElement('div');
						tech.className = 'r-tech';
						tech.textContent = `Technologies: ${entry.tech}`;
						container.appendChild(tech);
					}
				}
			}

			out.appendChild(container);
			trim();
			out.scrollTop = out.scrollHeight;
		}

		function findTarget(verb: 'open' | 'cd', key: string) {
			return targets.find((t) => t.verb === verb && t.key === key);
		}

		function run(raw: string) {
			const cmd = raw.trim();
			if (!cmd) return;
			print(`$ ${cmd}`);

			const [verb, ...rest] = cmd.split(/\s+/);
			const arg = rest.join(' ');

			if (verb === 'help') {
				print('commands: ls, cd <page>, open <link|all>, cat resume, help');
				return;
			}

			if (verb === 'ls') {
				print([...targets.map((t) => t.key), 'resume'].join('  '));
				return;
			}

			if (verb === 'cat') {
				const name = arg.replace(/^\.?\/?/, '');
				if (name === 'resume' && resume) {
					printResume(resume);
				} else {
					print(`cat: ${arg || 'missing operand'}: No such file`);
				}
				return;
			}

			if (verb === 'cd') {
				if (arg === '~' || arg === 'home' || arg === '') {
					window.location.href = '/';
					return;
				}
				const target = findTarget('cd', arg);
				if (target) {
					window.location.href = target.href;
				} else {
					print(`cd: no such page: ${arg}`);
				}
				return;
			}

			if (verb === 'open') {
				if (arg === 'all') {
					const openables = targets.filter((t) => t.verb === 'open');
					let blocked = 0;
					for (const t of openables) {
						const win = window.open(t.href, '_blank', 'noopener');
						if (!win) blocked += 1;
					}
					if (blocked > 0) {
						print(
							`opened ${openables.length - blocked}/${openables.length} links (${blocked} blocked by your browser's pop-up blocker)`,
						);
					} else {
						print(`opened ${openables.length} links: ${openables.map((t) => t.key).join(', ')}`);
					}
					return;
				}

				const target = findTarget('open', arg);
				if (target) {
					if (target.external) {
						window.open(target.href, '_blank', 'noopener');
					} else {
						window.location.href = target.href;
					}
				} else {
					print(`open: no such link: ${arg}`);
				}
				return;
			}

			print(`command not found: ${verb}`);
		}

		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter') {
				const value = input.value;
				run(value);
				if (value.trim()) {
					history.push(value.trim());
				}
				historyIndex = history.length;
				input.value = '';
			} else if (event.key === 'ArrowUp') {
				if (historyIndex > 0) {
					historyIndex -= 1;
					input.value = history[historyIndex] ?? '';
					requestAnimationFrame(() =>
						input.setSelectionRange(input.value.length, input.value.length),
					);
				}
				event.preventDefault();
			} else if (event.key === 'ArrowDown') {
				if (historyIndex < history.length - 1) {
					historyIndex += 1;
					input.value = history[historyIndex] ?? '';
				} else {
					historyIndex = history.length;
					input.value = '';
				}
				event.preventDefault();
			}
		});
	}
</script>
